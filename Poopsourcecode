-- Self-load guard: only fetch if this file is NOT the source itself
-- (prevents infinite recursive loadstring loops)
if _G.__POOPHUB_LOADED__ ~= true then
    _G.__POOPHUB_LOADED__ = true
    pcall(function()
        local fetched = game:HttpGet(SOURCE_URL)
        if fetched and #fetched > 0 and not fetched:find("SOURCE_URL") then
            loadstring(fetched)()
        end
    end)
end

