local Utility = {}

function Utility.Rejoin()
    Utils.Notify("PoopHub", "Rejoining server...")
    task.wait(0.5)
    TeleportService:TeleportToPlaceInstance(
        game.PlaceId,
        game.JobId,
        LocalPlayer
    )
end

function Utility.ServerHop()
    Utils.Notify("PoopHub", "Searching for new server...")
    local success, result = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/" ..
                game.PlaceId ..
                "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)
    if not success or not result then
        Utils.Notify("PoopHub", "Server hop failed")
        return
    end
    for _, server in ipairs(result.data) do
        if server.playing < server.maxPlayers
           and server.id ~= game.JobId then
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                server.id,
                LocalPlayer
            )
            return
        end
    end
    Utils.Notify("PoopHub", "No available servers found")
end

function Utility.ResetCharacter()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
            Utils.Notify("PoopHub", "Character reset")
        end
    end
end

function Utility.PrintPlayerList()
    print("[PoopHub] Player list:")
    for i, player in ipairs(Players:GetPlayers()) do
        print(string.format("  %d. %s (ID: %d)", i, player.Name, player.UserId))
    end
end

function Utility.ReloadFromSource()
    Utils.Notify("PoopHub", "Reloading from remote source...")
    task.wait(0.5)
    local ok, err = pcall(function()
        local fetched = game:HttpGet(SOURCE_URL)
        if fetched and #fetched > 0 then
            loadstring(fetched)()
        else
            error("empty response")
        end
    end)
    if not ok then
        Utils.Notify("PoopHub", "Reload failed: " .. tostring(err))
    end
end

-- ============================================================
-- [ Event Bindings ]
-- ============================================================

RunService.RenderStepped:Connect(function()
    if PoopHub.Toggles.FlyEnabled then
        local root = Utils.GetRootPart()
        local vel  = root and root:FindFirstChild("PoopFlyVelocity")
        if vel then
            local dir = Movement.GetMoveDirection()
            vel.Velocity = dir.Magnitude > 0
                and dir.Unit * PoopHub.Toggles.FlySpeed
                or Vector3.zero
        end
    end

    Visual.UpdateESP()
end)

RunService.Stepped:Connect(function()
    if PoopHub.Toggles.NoclipEnabled then
        Movement.Noclip()
    end
end)

RunService.Heartbeat:Connect(function()
    if PoopHub.Toggles.HitboxEnabled then
        Combat.SetupHitbox()
    end
end)

LocalPlayer.Idled:Connect(function()
    if not PoopHub.Toggles.AntiAFK then return end
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    Movement.ApplySpeed()
    Movement.ApplyJump()
    Movement.SetupInfJump()
    Movement.SetupFly()
    Combat.ApplyGodmode()
end)

