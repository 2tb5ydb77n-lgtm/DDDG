    end)

    AddToggle("Hitbox Expander", function()
        return PoopHub.Toggles.HitboxEnabled
    end, function(v)
        PoopHub.Toggles.HitboxEnabled = v
        Combat.SetupHitbox()
    end)

    AddHeader("UTILITY")

    AddToggle("Anti-AFK", function()
        return PoopHub.Toggles.AntiAFK
    end, function(v)
        PoopHub.Toggles.AntiAFK = v
    end)

    AddButton("Reset Character", function()
        Utility.ResetCharacter()
    end, Color3.fromRGB(150, 60, 60))

    AddButton("Rejoin Server", function()
        Utility.Rejoin()
    end, Color3.fromRGB(60, 110, 150))

    AddButton("Server Hop", function()
        Utility.ServerHop()
    end, Color3.fromRGB(60, 150, 110))

    AddButton("Print Player List", function()
        Utility.PrintPlayerList()
    end, Color3.fromRGB(90, 90, 120))

    AddButton("Reload from Source", function()
        Utility.ReloadFromSource()
    end, Color3.fromRGB(120, 80, 160))

    -- Update canvas size
    task.spawn(function()
        while scroll.Parent do
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
            task.wait(0.2)
        end
    end)

    -- Toggle GUI with RightShift
    UserInput.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            screenGui.Enabled = not screenGui.Enabled
        end
    end)

    return screenGui
end

