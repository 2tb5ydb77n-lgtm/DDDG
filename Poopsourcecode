local Utils = {}

function Utils.Notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = title,
            Text     = text,
            Duration = duration or 3
        })
    end)
end

function Utils.GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

function Utils.GetHumanoid()
    local char = Utils.GetCharacter()
    return char:FindFirstChildOfClass("Humanoid")
end

function Utils.GetRootPart()
    local char = Utils.GetCharacter()
    return char:FindFirstChild("HumanoidRootPart")
end

function Utils.Create(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

function Utils.FormatVector(v)
    return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
end

function Utils.SafeCall(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then return result end
    warn("[PoopHub] SafeCall error:", result)
    return nil
end

function Utils.DisconnectAll()
    for _, conn in pairs(PoopHub.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    PoopHub.Connections = {}
end

-- ============================================================
-- [ Movement Systems ]
-- ============================================================

local Movement = {}

function Movement.ApplySpeed()
    local hum = Utils.GetHumanoid()
    if not hum then return end
    hum.WalkSpeed = PoopHub.Toggles.SpeedEnabled
        and PoopHub.Toggles.SpeedValue
        or 16
end

function Movement.ApplyJump()
    local hum = Utils.GetHumanoid()
    if not hum then return end
    hum.UseJumpPower = true
    hum.JumpPower = PoopHub.Toggles.JumpEnabled
        and PoopHub.Toggles.JumpValue
        or 50
end

function Movement.SetupInfJump()
    if PoopHub.Connections.InfJump then
        PoopHub.Connections.InfJump:Disconnect()
    end
    PoopHub.Connections.InfJump = UserInput.JumpRequest:Connect(function()
        if not PoopHub.Toggles.InfJump then return end
        local hum = Utils.GetHumanoid()
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

function Movement.SetupFly()
    local root = Utils.GetRootPart()
    if not root then return end

    local vel = root:FindFirstChild("PoopFlyVelocity")
    if PoopHub.Toggles.FlyEnabled then
        if not vel then
            vel          = Instance.new("BodyVelocity")
            vel.Name     = "PoopFlyVelocity"
            vel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            vel.Velocity = Vector3.zero
            vel.Parent   = root
        end
    else
        if vel then vel:Destroy() end
    end
end

function Movement.GetMoveDirection()
    local dir = Vector3.zero
    if UserInput:IsKeyDown(Enum.KeyCode.W) then
        dir = dir + Camera.CFrame.LookVector
    end
    if UserInput:IsKeyDown(Enum.KeyCode.S) then
        dir = dir - Camera.CFrame.LookVector
    end
    if UserInput:IsKeyDown(Enum.KeyCode.A) then
        dir = dir - Camera.CFrame.RightVector
    end
    if UserInput:IsKeyDown(Enum.KeyCode.D) then
        dir = dir + Camera.CFrame.RightVector
    end
    if UserInput:IsKeyDown(Enum.KeyCode.Space) then
        dir = dir + Vector3.new(0, 1, 0)
    end
    if UserInput:IsKeyDown(Enum.KeyCode.LeftControl) then
        dir = dir - Vector3.new(0, 1, 0)
    end
    return dir
end

function Movement.Noclip()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

